<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	  
    <WarnOn>3390;$(WarnOn)</WarnOn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OtherFlags>--warnon:1182</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HS.fs" />
    <Compile Include="Winterop.fs" />
    <Compile Include="WinteropUtils.fs" />
    <Compile Include="WindowFocusTrackingUtils.fs" />
    <Compile Include="Utils.fs" />
    <Compile Include="Fourier.fs" />
    <Compile Include="StitchView.fs" />
    <Compile Include="Elephantasy.fs" />
    <Compile Include="BasicLayout.fs" />
    <Compile Include="GenericMetadata.fs" />
    <Compile Include="AppSettings.fs" />
    <Compile Include="GameSpecific.fs" />
    <Compile Include="BackingStoreData.fs" />
    <Compile Include="AreaSelection.fs" />
    <Compile Include="MultipleScreenshotForOneScreen.fs" />
    <Compile Include="InMemoryStore.fs" />
    <Compile Include="Autocomplete.fs" />
    <Compile Include="MapIcons.fs" />
    <Compile Include="FeatureWindow.fs" />
    <Compile Include="MinimapWindow.fs" />
    <Compile Include="Popouts.fs" />
    <Compile Include="PopoutsSettings.fs" />
    <Compile Include="PreviewPane.fs" />
    <Compile Include="TrimWorkflow.fs" />
    <Compile Include="QuickNav.fs" />
    <Compile Include="Generic.fs" />
    <Content Include="TODO.txt" />
    <Compile Include="Glass.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup />

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows" />
	<Reference Include="System.Windows.Forms" />
	<Reference Include="System.Windows.Presentation" />
    <Reference Include="System.Xaml" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
  </ItemGroup>

	<Target Name="RemoveSatelliteAssemblies" AfterTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<!-- Removes all non-English localized folders brought in by NuGet packages or 3rd party DLLs -->
			<ReferenceCopyLocalPaths Remove="@(ReferenceSatellitePaths)" />
		</ItemGroup>
	</Target>
	<Target Name="DeleteLanguageFolders" AfterTargets="Build">
		<ItemGroup>
			<LanguageFolders Include="$(TargetDir)*\" />
		</ItemGroup>
	</Target>

</Project>